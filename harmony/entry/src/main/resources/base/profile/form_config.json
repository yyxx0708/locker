      "description": "$string:widget_desc",
      "src": "./ets/widget/pages/LockerWidgetCard.ets",
      "uiSyntax": "arkts",
      "window": {
        "designWidth": 720,
        "autoDesignWidth": true
      },
      "colorMode": "auto",
      "isDynamic": true,
      "isDefault": true,
      "updateEnabled": true,
      "scheduledUpdateTime": "00:01",
      "updateDuration": 1,
      "defaultDimension": "2*2",
      "supportDimensions": [
        "2*2",
        "4*4"
      ],
      "formConfigAbility": "ability://EntryFormEditAbility",
      "metadata": [
        {
          "name": "ohos.extension.form.config",
          "value": "{\"isSupportedDimensions\":true}"
        }
      ]
    }
  ]
}
