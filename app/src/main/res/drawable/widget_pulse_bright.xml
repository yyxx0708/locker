<?xml version="1.0" encoding="utf-8"?>
<!-- 呼吸灯亮帧：实心蓝点 + 柔和光晕 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#552A78D6" />
            <size
                android:width="16dp"
                android:height="16dp" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:right="3dp"
        android:top="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#2A78D6" />
        </shape>
    </item>
</layer-list>
